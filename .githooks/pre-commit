#!/usr/bin/env bash
# Blocks a commit that would put plaintext secrets or a private key into git.
#
# Enable once per clone:   git config core.hooksPath .githooks
# Bypass (you had better be sure):   git commit --no-verify
set -o errexit
set -o nounset
set -o pipefail

fail() { printf '\033[31mpre-commit: %s\033[0m\n' "$*" >&2; }

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$staged" ] || exit 0

violations=0

while IFS= read -r path; do
  [ -n "$path" ] || continue

  # 1. Decrypted secrets.
  case "$path" in
    env/dec/.gitignore) : ;;
    env/dec/*)
      fail "$path is decrypted plaintext — it must never be committed."
      violations=$((violations + 1)); continue ;;
  esac

  # 2. A dotenv outside env/, other than a template.
  case "$path" in
    *.example|*.sample|*.template|env/enc/*) : ;;
    .env|.env.*|*/.env|*/.env.*)
      fail "$path looks like a plaintext dotenv. Put secrets in env/enc/ via scripts/env-crypto.sh."
      violations=$((violations + 1)); continue ;;
  esac

  # 3. Private key material, wherever it lives.
  #    Anchored on the PEM delimiters and on real age key material rather than
  #    the bare prefixes: the unanchored form matched this hook's own source
  #    (the alternation contains the literal AGE-SECRET-KEY-1), so the hook
  #    flagged itself and could never be committed. It also fired on prose that
  #    merely mentions BEGIN PRIVATE KEY.
  if git show ":$path" 2>/dev/null | head -c 8192 | grep -qE \
      'AGE-SECRET-KEY-1[0-9A-Z]{50,}|-----BEGIN (RSA |EC |OPENSSH |PGP )?PRIVATE KEY-----'; then
    fail "$path contains a private key."
    violations=$((violations + 1)); continue
  fi

  # 4. Provider credentials pasted into a tracked file. Deliberately narrow —
  #    these prefixes are unambiguous, so false positives are rare enough that
  #    blocking is the right call.
  if git show ":$path" 2>/dev/null | head -c 65536 | grep -qE \
      'SG\.[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{20,}|pat-(na|eu)1-[0-9a-f]{8}-|AIza[0-9A-Za-z_-]{35}|xox[baprs]-[0-9A-Za-z-]{20,}|ghp_[0-9A-Za-z]{36}'; then
    case "$path" in
      *.example|*.sample|*.template|*/test/*|*.test.*|*docs/*) : ;;
      *)
        fail "$path contains something shaped like a live API credential."
        violations=$((violations + 1)); continue ;;
    esac
  fi
done <<< "$staged"

# 5. Ciphertext that is not actually encrypted.
while IFS= read -r path; do
  case "$path" in
    env/enc/*.enc) : ;;
    *) continue ;;
  esac
  if ! git show ":$path" 2>/dev/null | head -c 4096 | grep -qE \
      '^(#benefactor-env-crypto:|-----BEGIN AGE ENCRYPTED FILE-----|sops_version=|sops:)|=ENC\[AES256_GCM,'; then
    fail "$path is under env/enc/ but is not recognizable ciphertext."
    violations=$((violations + 1))
  fi
done <<< "$staged"

if [ "$violations" -gt 0 ]; then
  printf '\033[31mpre-commit: %d problem(s); commit aborted.\033[0m\n' "$violations" >&2
  printf 'Run `scripts/env-crypto.sh doctor` for the repository-wide view.\n' >&2
  exit 1
fi

exit 0
